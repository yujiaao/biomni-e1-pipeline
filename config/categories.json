    {"id": "epidemiology",        "name": "Epidemiology",                          "enabled": true},
    {"id": "evolutionary_bio",    "name": "Evolutionary Biology",                  "enabled": true},
    {"id": "genetics",            "name": "Genetics",                              "enabled": true},
    {"id": "genomics",            "name": "Genomics",                              "enabled": true},
    {"id": "immunology",          "name": "Immunology",                            "enabled": true},
