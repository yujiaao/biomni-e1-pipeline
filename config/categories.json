    {"id": "cell_biology",        "name": "Cell Biology",                          "enabled": true},
    {"id": "clinical_trials",     "name": "Clinical Trials",                       "enabled": true},
    {"id": "developmental_bio",   "name": "Developmental Biology",                 "enabled": true},
