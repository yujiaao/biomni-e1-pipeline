{
  "project": "biomni-e1-repro",
  "description": "文献驱动的工具环境构建（Biomni-E1 方法论复现）。本文件定义论文选取阶段使用的子领域与平台配置。",
  "platforms": {
    "biorxiv": {
      "api_base": "https://api.biorxiv.org/details/biorxiv",
      "pdf_base": "https://www.biorxiv.org/content",
      "has_api": true,
      "note": "生物医学预印本，文章采用其原生 25 个子领域分类"
    },
    "medrxiv": {
      "api_base": "https://api.biorxiv.org/details/medrxiv",
      "pdf_base": "https://www.medrxiv.org/content",
      "has_api": true,
      "note": "医学预印本，API 复用 bioRxiv 接口"
    }
  },
  "selection": {
    "recency_months": 18,
    "papers_per_category": 100,
    "demo": {
      "recency_days": 30,
      "papers_per_category": 3,
      "enabled": false
    },
    "min_papers_per_category_per_year": 50,
    "exclude": ["review", "correction", "retraction", "preprint-note"]
  },
  "categories": [
